<div class="login-wrapper" style="min-height: 80vh; display: flex; align-items: center; justify-content: center; padding: 2rem 1rem;">
  <div class="login-card" style="width: 100%; max-width: 420px; background-color: var(--surface); border: 1px solid var(--border); border-radius: var(--radius); padding: 2.25rem; box-shadow: 0 16px 36px -8px rgba(0,0,0,0.8);">
    <div style="text-align: center; margin-bottom: 2rem;">
      <div class="brand-logo-wrap" style="width: 48px; height: 48px; margin: 0 auto 1rem auto; font-size: 1.25rem;">HB</div>
      <h1 style="margin: 0; font-size: 1.6rem; font-weight: 800; color: #ffffff;">HuskyByte</h1>
      <p style="margin: 0.35rem 0 0 0; font-size: 0.85rem; color: var(--text-muted);">Acceso al Panel de Administración</p>
    </div>

    <% if flash[:notice] %>
      <div class="flash notice"><%= flash[:notice] %></div>
    <% end %>

    <% if flash[:alert] %>
      <div class="flash alert"><%= flash[:alert] %></div>
    <% end %>

    <%= form_with url: login_path, method: :post, local: true, style: "background: transparent; border: none; padding: 0; box-shadow: none; max-width: none;" do %>
      <div>
        <label for="email">Correo electrónico de administrador</label>
        <%= text_field_tag :email, nil, placeholder: "admin@test.com", required: true, autofocus: true, id: "email" %>
      </div>

      <div>
        <label for="password">Contraseña</label>
        <%= password_field_tag :password, nil, placeholder: "••••••••", required: true, id: "password" %>
      </div>

      <div style="margin-top: 1.5rem; margin-bottom: 0;">
        <%= submit_tag "Ingresar al panel", class: "btn-primary", style: "width: 100%; justify-content: center; padding: 0.75rem;" %>
      </div>
    <% end %>

    <div style="margin-top: 1.75rem; text-align: center; font-size: 0.78rem; color: var(--text-dim); border-top: 1px solid var(--border); padding-top: 1rem;">
      Sistema de Gestión Universitaria · UTN - TUP
    </div>
  </div>
</div>
