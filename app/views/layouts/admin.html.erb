<!DOCTYPE html>
<html lang="es">
  <head>
    <title>Admin · HuskyByte</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag "admin", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="admin">
    <header class="admin-header">
      <%= link_to admin_root_path, class: "admin-brand" do %>
        <span class="brand-logo-wrap">HB</span>
        <strong>HuskyByte</strong>
        <span class="badge-admin">Admin</span>
      <% end %>

      <nav aria-label="Navegación del panel de administración">
        <%= link_to "Categorías", admin_categories_path, class: ("active" if controller_name == "categories") %>
        <%= link_to "Cursos", admin_courses_path, class: ("active" if controller_name == "courses") %>
        <%= link_to "Lecciones", admin_lessons_path, class: ("active" if controller_name == "lessons") %>
        <%= link_to "Usuarios", admin_users_path, class: ("active" if controller_name == "users") %>
        <%= link_to "Reseñas", admin_reviews_path, class: ("active" if controller_name == "reviews") %>
      </nav>

      <div class="user-box">
        <span class="user-name"><%= current_user&.name || "Administrador" %></span>
        <%= button_to "Cerrar sesión", logout_path, method: :delete, class: "logout" %>
      </div>
    </header>

    <main class="admin-main">
      <% if notice %>
        <div class="flash notice" role="status"><%= notice %></div>
      <% end %>
      <% if alert %>
        <div class="flash alert" role="alert"><%= alert %></div>
      <% end %>

      <%= yield %>
    </main>

    <footer class="admin-footer">
      <p>© 2026 <strong>HuskyByte</strong> · Panel de Control y Gestión · UTN - TUP</p>
    </footer>
  </body>
</html>
