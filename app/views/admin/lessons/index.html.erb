<h1>Lecciones</h1>
<%= link_to "Nueva lección", new_admin_lesson_path %>
<%= link_to "Volver a cursos", admin_courses_path %>

<table border="1" cellpadding="5">
  <tr>
    <th>Título</th>
    <th>Curso</th>
    <th>Posición</th>
    <th></th>
  </tr>
  <% @lessons.each do |lesson| %>
    <tr>
      <td><%= lesson.title %></td>
      <td><%= lesson.course.title %></td>
      <td><%= lesson.position %></td>
      <td>
        <%= link_to "Editar", edit_admin_lesson_path(lesson) %>
        <%= link_to "Eliminar", admin_lesson_path(lesson), data: { turbo_method: :delete, turbo_confirm: "¿Seguro?" } %>
      </td>
    </tr>
  <% end %>
</table>