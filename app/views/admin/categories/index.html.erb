<h1>Categorías</h1>
<%= link_to "Nueva categoría", new_admin_category_path %>

<table border="1" cellpadding="5">
  <tr>
    <th>Nombre</th>
    <th>Descripción</th>
    <th></th>
  </tr>
  <% @categories.each do |category| %>
    <tr>
      <td><%= category.name %></td>
      <td><%= category.description %></td>
      <td>
        <%= link_to "Editar", edit_admin_category_path(category) %>
        <%= link_to "Eliminar", admin_category_path(category), data: { turbo_method: :delete, turbo_confirm: "¿Seguro?" } %>
      </td>
    </tr>
  <% end %>
</table>