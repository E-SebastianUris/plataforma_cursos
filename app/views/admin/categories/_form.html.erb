<%= form_with model: [:admin, category] do |f| %>
  <% if category.errors.any? %>
    <div class="flash alert">
      <ul style="margin: 0; padding-left: 1.25rem;">
        <% category.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= f.label :name, "Nombre de la categoría" %>
    <%= f.text_field :name, placeholder: "Ej: Inteligencia Artificial" %>
  </div>

  <div>
    <%= f.label :description, "Descripción" %>
    <%= f.text_area :description, placeholder: "Breve resumen de las tecnologías abarcadas..." %>
  </div>

  <div style="margin-top: 1.5rem; margin-bottom: 0;">
    <%= f.submit "Guardar categoría", class: "btn-primary" %>
  </div>
<% end %>
