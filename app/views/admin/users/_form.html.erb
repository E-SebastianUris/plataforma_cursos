<%= form_with model: [:admin, user] do |f| %>
  <% if user.errors.any? %>
    <div class="flash alert">
      <ul style="margin: 0; padding-left: 1.25rem;">
        <% user.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= f.label :name, "Nombre completo" %>
    <%= f.text_field :name, placeholder: "Ej: Juan Pérez" %>
  </div>

  <div>
    <%= f.label :email, "Correo electrónico" %>
    <%= f.email_field :email, placeholder: "usuario@ejemplo.com" %>
  </div>

  <div>
    <%= f.label :password, user.new_record? ? "Contraseña" : "Nueva contraseña (dejar vacía si no se modifica)" %>
    <%= f.password_field :password, placeholder: "Mínimo 6 caracteres" %>
  </div>

  <div>
    <%= f.label :role, "Rol en la plataforma" %>
    <%= f.select :role, User.roles.keys.map { |r| [r.humanize, r] } %>
  </div>

  <div style="margin-top: 1.5rem; margin-bottom: 0;">
    <%= f.submit "Guardar usuario", class: "btn-primary" %>
  </div>
<% end %>
