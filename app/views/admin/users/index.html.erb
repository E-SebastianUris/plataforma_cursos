<h1>Usuarios</h1>
<%= link_to "Nuevo usuario", new_admin_user_path %>

<table>
  <tr>
    <th>Nombre</th>
    <th>Email</th>
    <th>Rol</th>
    <th></th>
  </tr>
  <% @users.each do |user| %>
    <tr>
      <td><%= user.name %></td>
      <td><%= user.email %></td>
      <td><%= user.role.humanize %></td>
      <td>
        <%= link_to "Editar", edit_admin_user_path(user) %>
        <%= link_to "Eliminar", admin_user_path(user), data: { turbo_method: :delete, turbo_confirm: "¿Seguro? Si es profesor, se eliminan también sus cursos." } %>
      </td>
    </tr>
  <% end %>
</table>